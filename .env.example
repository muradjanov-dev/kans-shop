# ============================================================
# Kans Shop — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Telegram ---
# Token from @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Bot username WITHOUT @, used to build deep links (t.me/<BOT_USERNAME>?start=...)
BOT_USERNAME=kansshop_bot
# Public HTTPS URL Telegram will POST updates to in production (e.g. https://kansshop.up.railway.app/webhook).
# Leave empty for local polling mode (bot_polling.py).
WEBHOOK_URL=
# Random secret Telegram must echo back in the X-Telegram-Bot-Api-Secret-Token header.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me-webhook-secret
# Comma-separated Telegram user IDs that get superadmin access on first /start, even before
# an `admins` row exists for them (bootstrap only — after that, manage roles via the DB/admin panel).
ADMIN_IDS=917456291
# Chat/channel ID where uncaught exceptions are reported (can be your own admin chat id to start).
ERROR_CHANNEL_ID=917456291
# Chat/channel ID new orders are additionally posted to (besides each admin's DM). Optional.
ORDERS_CHANNEL_ID=

# --- Mandatory channel subscription ---
# Users must be subscribed to this channel before the bot answers them. Leave empty to disable.
# The bot MUST be an administrator of the channel, otherwise Telegram rejects getChatMember
# and the gate fails open (everyone is let through and the error is logged).
REQUIRED_CHANNEL_ID=-1003642407474
# Optional join link shown on the gate button. Leave empty to resolve it from the channel
# itself at runtime (@username, else an invite link the bot generates).
REQUIRED_CHANNEL_URL=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://kansshop:kansshop@localhost:5432/kansshop
# Used only by Alembic (sync driver) — same credentials, psycopg driver.
DATABASE_URL_SYNC=postgresql+psycopg://kansshop:kansshop@localhost:5432/kansshop

# --- Redis (FSM storage, cache, rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (Mini App / Web Admin JWT) ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# --- Web / API ---
WEBAPP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
MEDIA_ROOT=./media
MEDIA_BASE_URL=http://localhost:8000/media

# --- Misc ---
DEFAULT_LANGUAGE=uz
TIMEZONE=Asia/Tashkent
CURRENCY=UZS
DEBUG=false

# --- Payments: Click ---
# Get these from my.click.uz Merchant Cabinet after registering your business there.
# Leave blank to keep Click disabled (checkout simply won't offer it).
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# --- Payments: Payme ---
# Get these from business.payme.uz after creating a Kassa (cash register). Payme issues
# separate test and production merchant IDs/keys — use the test ones while integrating.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# --- Payments: Paynet ---
# Obtained from Paynet after signing a merchant agreement with them; PAYNET_API_BASE_URL is
# whatever endpoint they hand you (their API isn't a public/standardized spec like Click/Payme).
PAYNET_MERCHANT_ID=
PAYNET_SECRET_KEY=
PAYNET_API_BASE_URL=
