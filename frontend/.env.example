# Copy to .env.local for local dev. Vite only exposes vars prefixed VITE_ to client code.
# In production this is instead baked in at Docker build time as /api/v1 (relative — same
# origin as nginx, which proxies /api/ to the api service) via docker-compose.yml's build arg.
VITE_API_BASE_URL=http://localhost:8000/api/v1
